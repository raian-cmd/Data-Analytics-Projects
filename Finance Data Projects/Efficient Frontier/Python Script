# Optimize the Frontier 
# # derived from class example
def efficient_frontier():
    # Stats Function
    def statistics(weights):
        weights = np.array(weights)
        portfolio_return = np.dot(predicted_returns * 252,weights)
        portfolio_vol = np.sqrt(np.dot(weights.T,np.dot(returns.cov() * 252, weights)))
        sharpe_ratio = (portfolio_return - risk_free_rate)/ portfolio_vol
        return np.array([portfolio_return,portfolio_vol,sharpe_ratio])
    
    # Minimzing Volatility
    def minimize_volatility(weights):
        return statistics(weights)[1]
    # Bound
    bounds = tuple((0,1) for asset in range(len(tickers)))
    # initial guess
    init_guess = len(tickers) * [1 / len(tickers)]
    # generate frontier returns
    frontier_returns = np.linspace(results[0].min(),results[0].max(),100)
    frontier_volatility = []
    # Optimization Loop
    for target_return in frontier_returns:
        constraints = (
            {'type': 'eq','fun': lambda x: statistics(x)[0] - target_return},
            {'type': 'eq','fun': lambda x:np.sum(x) - 1})
        optimization = minimize(
            minimize_volatility,
            init_guess,
            method='SLSQP',
            bounds=bounds,
            constraints=constraints)
        frontier_volatility.append(optimization['fun'])
    return frontier_volatility, frontier_returns
frontier_volatility, frontier_returns = efficient_frontier()
