#Cleaning BLS Unrate, changing Month format and removing other columns except for total and month

library(dplyr)

unrate <- unrate %>%
  select(Month, Total)
  
library(lubridate)

unrate <- unrate %>%
  mutate(Month = parse_date_time(Month, orders = "b Y"))

unrate <- unrate %>%
  mutate(Month = as.Date(floor_date(Month, "month")))

#Merging into final_data
final_data <- final_data %>%
  left_join(unrate, by = "Month")
  
#Cleaning QQQ Data

library(dplyr)

qqq <- qqq %>%
  select(Date, Close)

#Fix Date Format
qqq$Date <- as.Date(qqq$Date)

library(lubridate)

#Convert Into Monthly Prices at the end of the month
qqq_monthly <- qqq %>%
  mutate(Month = floor_date(Date, "month")) %>%
  group_by(Month) %>%
  summarise(Price = last(Close))
  
#Calculate Returns
qqq_monthly <- qqq_monthly %>%
  mutate(Return = (Price / lag(Price)) - 1)

#Clean any NA Rows
qqq_monthly <- qqq_monthly %>%
  filter(!is.na(Log_Return))

#Merge into Final Data
final_data <- final_data %>%
  left_join(qqq_monthly, by = "Month")

