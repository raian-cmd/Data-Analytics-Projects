-- People that Live in each city
SELECT 
    City,
    COUNT(*) AS number_of_people
FROM airline_loyalty_customer_history
GROUP BY City
ORDER BY number_of_people DESC;

-- Average miles flown 2017 - 2018 All Cities 
WITH monthly AS (
  SELECT
    "Year",
    "Month",
    SUM(Distance) AS total_km
  FROM airline_loyalty_flight_activity
  GROUP BY "Year", "Month"
)
SELECT
  "Month",
  AVG(total_km) AS total_km_for_this_month
FROM monthly
GROUP BY "Month"
ORDER BY "Month";
