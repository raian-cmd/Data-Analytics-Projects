#  Calculate Daily Returns
returns = data.pct_change().dropna()

# Regression-Based Expected Returns 
#Linear Regression Video Of Where I Got It From: 
predicted_returns = []

# Regression Loop
for stock in returns.columns:
    stock_data = data[stock].copy()

    df = pd.DataFrame()
    # Daily returns
    df["return"] = stock_data.pct_change()
    # Lagged return
    df["lag_return"] = df["return"].shift(1)
    # Volatility
    df["volatility"] = df["return"].rolling(5).std()
    df = df.dropna()

    y = df["return"]
    X = df[["lag_return", "volatility"]]

    model = LinearRegression()
    model.fit(X, y)

    prediction = model.predict(X)
    predicted_returns.append(np.mean(prediction))
predicted_returns = np.array(predicted_returns)

