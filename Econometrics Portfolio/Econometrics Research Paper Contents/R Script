# Graphs for diagnostics
#Multicolinearyt check

library(ggplot2)

vif_values <- vif(model7)

vif_df <- data.frame(
  Variable = names(vif_values),
  VIF = vif_values
)

ggplot(vif_df, aes(x = reorder(Variable, VIF), y = VIF, fill = VIF > 10)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  
  # Color scale: good vs bad
  scale_fill_manual(
    values = c("TRUE" = "#E63946",   # red (problem)
               "FALSE" = "#2A9D8F"), # green/teal (good)
    guide = "none"
  ) +
  
  # Red threshold line
  geom_hline(yintercept = 10, linetype = "dashed", color = "#E63946", linewidth = 1) +
  
  # Labels on bars
  geom_text(aes(label = round(VIF, 2)), 
            hjust = -0.2, size = 4) +
  
  labs(
    title = "Multicollinearity Check (VIF)",
    subtitle = "Red bars indicate problematic variables (VIF > 10)",
    x = "Variables",
    y = "VIF"
  ) +
  
  theme_minimal(base_size = 14) +
  theme(
    plot.title = element_text(face = "bold"),
    axis.text.y = element_text(face = "bold")
  ) +
  
  # Extend axis so labels fit
  ylim(0, max(vif_df$VIF) * 1.2)
  
