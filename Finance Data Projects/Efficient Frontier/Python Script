#Only Running A monte carlo simulation to keep things simple, portfolio calculations are
#outside of the class as well as creating the heatmap
class monteCarlo:

    def __init__(self, returns, risk_free_rate, num_portfolios=20000):
        self.returns = returns
        self.risk_free_rate = risk_free_rate
        self.num_portfolios = num_portfolios
        self.results = np.zeros((3, num_portfolios))
        self.weights_record = []

    def run_simulation(self, tickers):

        for i in range(self.num_portfolios):

            weights = np.random.random(len(tickers))
            weights /= np.sum(weights)

            self.weights_record.append(weights)
            annual_return = np.dot(self.returns.mean(), weights) * 252
            cov_matrix = self.returns.cov() * 252
            annual_vol = np.sqrt(np.dot(weights.T, np.dot(cov_matrix, weights)))
            sharpe = (annual_return - self.risk_free_rate) / annual_vol

            self.results[0, i] = annual_return
            self.results[1, i] = annual_vol
            self.results[2, i] = sharpe

