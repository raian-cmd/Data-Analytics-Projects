cpi_raw <- SeriesReport_20260217182122_93b945

# Remove rows that are not actual year values
cpi_raw <- cpi_raw %>%
  filter(!is.na(Year))

# Convert from wide (Jan–Dec) to long format
cpi_long <- cpi_raw %>%
  pivot_longer(
    cols = Jan:Dec,
    names_to = "month",
    values_to = "cpi"
  )

# Create proper yyyy-mm-dd date
cpi_long <- cpi_long %>%
  mutate(
    month_num = match(month, month.abb),
    date = as.Date(paste(Year, month_num, "01", sep = "-"))
  ) %>%
  select(date, cpi) %>%
  arrange(date)

