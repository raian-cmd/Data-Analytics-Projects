-- cities
SELECT DISTINCT city
from airline_loyalty_customer_history
-- Total Km Flown historical all around for 2017 and 2018
-- 2017
SELECT
  Year,
  Month,
  SUM(Distance) AS total_km
FROM airline_loyalty_flight_activity
WHERE Year = 2017 and Month BETWEEN 1 and 12
GROUP BY Year, Month
ORDER BY Year, Month;

--2018
SELECT
  Year,
  Month,
  SUM(Distance) AS total_km
FROM airline_loyalty_flight_activity
WHERE Year = 2018 and Month BETWEEN 1 and 12
GROUP BY Year, Month
ORDER BY Year, Month;

-- now find the total km flown during each month of 2017 in each city
-- January
SELECT
    fl.Year,
    fl.Month,
    c.City,
    SUM(fl.Distance) AS total_km
FROM airline_loyalty_flight_activity fl
JOIN airline_loyalty_customer_history c
      ON fl.Loyalty_Number = c.Loyalty_Number 
WHERE fl.Year = 2017 and fl.Month = 1
GROUP BY 
    fl.Year,
    fl.Month,
    c.City
ORDER BY 
    fl.Year,
    fl.Month,
    c.City

